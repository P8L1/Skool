procedure TForm1.btnHoogsteClick(Sender: TObject);
var
tfPunte : TextFile;
sReel : String;
iLeerders : Integer;
iKeuse : Integer;
dGem, dGemVak1, dGemVak2 : Double;
iVak1, iVak2, iTotaalVak1, iTotaalVak2: Integer;
sNaam, sVan, sGraad, sMsg : String;
arLaagste : Array of String;
begin
try
  iKeuse := rgbGraad.ItemIndex;
  ShowMessage('IKeuse' + IntToStr(iKeuse));

  AssignFile(tfPunte, 'Punte.txt');
  Reset(tfPunte);

  SetLength(arLaagste, 3);
  // naam van punt
  case iKeuse of
     1: sGraad := '10';
     2: sGraad := '11';
     3: sGraad := '12';
  end;
  arLaagste[2] := '0';
  while not EOF(tfPunte) do
  // Piet Snoek#81 90
    begin
      Inc(iLeerders);

      sNaam := '';
      sVan := '';
      dGem := 0;
      iVak1 := 0;
      iVak2 := 0;

      Readln(tfPunte, sReel);

      sNaam := Trim(copy(sReel, 1, pos(' ', sReel) - 1));
      sNaam := sNaam[1];
      delete(sReel, 1, pos(' ', sReel));
      sVan := Trim(copy(sReel, 1, pos('#', sReel) - 1));
      iVak1 := StrToInt(copy(sReel, pos('#', sReel) + 1, 2));
      iVak2 := StrToInt(copy(sReel, pos('#', sReel) + 4, 2));

      dGem := (iVak1 + iVak2) /2;

      if StrTOFLoat(arLaagste[2]) < dGem then
      begin
           arLaagste[2] := FloatToStr(dGem);
           arLaagste[0]  :=  sNaam;
           arLaagste[1] := sVan;
      end;

    end;
    arLaagste[2] := FLoatTOStr(RoundTo(StrToFloat(arLaagste[2]), -2));
    sMsg := arLaagste[0] + ' ' + arLaagste[1] + ' ' + arLaagste[2];
    ShowMessage(sMsg);
finally
 CloseFIle(tfPunte);
end;
end;

