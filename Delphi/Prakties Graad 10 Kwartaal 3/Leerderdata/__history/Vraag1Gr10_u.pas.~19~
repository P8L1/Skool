procedure TForm1.btnVerwerkClick(Sender: TObject);
var
tfPunte : TextFile;
sReel : String;
iLeerders : Integer;
iKeuse : Integer;
dGem, dGemVak1, dGemVak2 : Double;
iVak1, iVak2, iTotaalVak1, iTotaalVak2: Integer;
sNaam, sVan, sGraad : String;

begin
try
  iKeuse := rgbGraad.ItemIndex;
  ShowMessage('IKeuse' + IntToStr(iKeuse));

  AssignFile(tfPunte, 'Punte.txt');
  Reset(tfPunte);

  case iKeuse of
     0: sGraad := '10';
     1: sGraad := '11';
     2: sGraad := '12';
  end;
  while not EOF(tfPunte) do
  // Piet Snoek#81 90
    begin
      Inc(iLeerders);

      sNaam := '';
      sVan := '';
      dGem := 0;
      iVak1 := 0;
      iVak2 := 0;

      Readln(tfPunte, sReel);

      sNaam := Trim(copy(sReel, 1, pos(' ', sReel) - 1));
      delete(sReel, 1, pos(' ', sReel));
      sVan := Trim(copy(sReel, 1, pos('#', sReel) - 1));
      iVak1 := StrToInt(copy(sReel, pos('#', sReel) + 1, 2));
      iVak2 := StrToInt(copy(sReel, pos('#', sReel) + 4, 2));

      iTotaalVak1 := iTotaalVak1 + iVak1;
      iTotaalVak2 := iTotaalVak1 + iVak2;

      dGem := (iVak1 + iVak2) / 2;
      dGem := RoundTo(dGem, -1);

      redAfvoer.Lines.Add(sGraad + #9 + sNaam + #9 + sVan +  #9 + IntToStr(iVak1) + #9 + IntToStr(iVak2) + #9 + FloatToStr(dGem) ) ;
    end;

    dGemVak1 := RoundTo((iTotaalVak1/iLeerders), -1);
    dGemVak2 := RoundTo((iTotaalVak2/iLeerders), -1);
    redAfvoer.Lines.Add('');
    redAfvoer.Lines.Add(#9 + #9 + #9 + '====' + #9 + '===='  ) ;
    redAfvoer.Lines.Add(#9 + #9 + #9  + FloatToStr(dGemVak1) + #9 + FloatToStr(dGemVak2)  ) ;
finally
 CloseFIle(tfPunte);
end;
end;

