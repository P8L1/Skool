type
  TForm2 = class(TForm)
    RichEdit1: TRichEdit;
    Button1: TButton;
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form2: TForm2;
  ResArr : TArray<string>;

implementation

{$R *.dfm}



procedure SplitString(const Input, Delimiter: string);
var
SL : TStringList;
I :Integer;
begin
  SL := TStringList.Create;
  try
    SL.Delimiter := Delimiter[1];
    SL.StrictDelimiter := True;
    SL.DelimitedText := Input;
    SetLength(ResArr, SL.Count);
    for I := 0 to SL.Count - 1 do
         begin
           ResArr[I] := SL[I];
         end;
  finally

       SL.Free;
  end;
end;


function GiveL(const Input, Delimiter: string; arrI : TArray<string>);
var
SL : TStringList;
I :Integer;
begin
  SL := TStringList.Create;

    SL.Delimiter := Delimiter[1];
    SL.StrictDelimiter := True;
    SL.DelimitedText := Input;
    SetLength(arrI, SL.Count);

end;

procedure TForm2.Button1Click(Sender: TObject);
var

tf : TextFile;
sReel, sPlaceholder : String;
arPlaceholder : TArray<string>;

begin
      AssignFile(tf, 'Data.txt');
      Reset(tf);
      while not EOF(tf) do
      begin
        Readln(tf, sReel);
        SplitString(sReel, ',');
        RichEdit1.Lines.Add(ResArr[0]);

      end;
end;

end.
