procedure SplitString(const Input, Delimiter: string; out Output: TArray<string>);
var
SL : TStringList;
I :Integer;
begin
  SL := TStringList.Create;
  try
    SL.Delimiter := Delimiter[1];
    SL.StrictDelimiter := True;
    SL.DelimitedText := Input;
    SetLength(Output, SL.Count);
    for I := 0 to SL.Count - 1 do
         begin
           Output[I] := SL[I];
         end;
  finally
       SL.Free;
  end;
end;

